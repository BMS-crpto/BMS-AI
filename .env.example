# ---- AI providers (server-side only; never prefix with NEXT_PUBLIC_) ----
# Configure at least one. Fallback only works for providers that have a key.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Free-tier providers (free usage still has rate limits)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Order used for "Auto select" and for fallback. Free-tier providers come before paid ones by default.
AI_PROVIDER_ORDER=gemini,groq,openrouter,anthropic,openai

# Optional model overrides (check each provider's current model list).
# GEMINI_MODEL=   OPENAI_MODEL=   ANTHROPIC_MODEL=   GROQ_MODEL=   OPENROUTER_MODEL=
# Per-mode: GEMINI_MODEL_FAST / _THINKING / _CODING / _RESEARCH (same for OPENAI_, ANTHROPIC_)

# ---- Research mode web search (one key is enough; Tavily is tried first) ----
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=

# ---- Timeouts / quota handling (optional) ----
# AI_TIMEOUT_MS=40000              per provider call
# AI_TOTAL_BUDGET_MS=85000         whole request, all providers and retries
# AI_QUOTA_COOLDOWN_SECONDS=900    how long an out-of-quota provider is skipped

# ---- Accounts and persistent chat ----
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bms_ai?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# ---- Owner-only read-only connectors (/github, /render commands in chat) ----
# Only these accounts may use them (comma separated, the email you registered with)
ADMIN_EMAILS=
# GitHub fine-grained token: only the BMS-AI repo, permissions Contents: Read-only + Metadata: Read-only
GITHUB_TOKEN=
# GITHUB_OWNER=BMS-crpto
# Render API key (Account Settings -> API Keys). Render keys are full-access; the code only ever sends GET requests.
RENDER_API_KEY=
