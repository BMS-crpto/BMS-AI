# Add at least one provider key. Keep secrets server-side; never prefix them with NEXT_PUBLIC_.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Optional defaults
BMS_DEFAULT_PROVIDER=openai
BMS_DEFAULT_MODEL=

# Required for accounts and persistent chat
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/bms_ai?schema=public"
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
